[database]
two_phase_commit=false

[database:app]
name=acoustid_app
user=acoustid
password=acoustid
host=127.0.0.1
port=5432

[database:fingerprint]
name=acoustid_fingerprint
user=acoustid
password=acoustid
host=127.0.0.1
port=5432

[database:ingest]
name=acoustid_ingest
user=acoustid
password=acoustid
host=127.0.0.1
port=5432

[database:musicbrainz]
name=musicbrainz
user=acoustid
password=acoustid
host=127.0.0.1
port=5432

[cluster]
role=master
base_master_url=https://api.acoustid.org/
secret=XXX

[index]
host=127.0.0.1
port=6080

[redis]
host=127.0.0.1
port=6379

[logging]
level=WARNING
#level.sqlalchemy=INFO

[website]
base_url=http://acoustid.org/
base_https_url=https://acoustid.org/
secret=XXX
mb_oauth_client_id=XXX
mb_oauth_client_secret=XXX

[sentry]
dsn=
traces_sample_rate=0.0

[gunicorn]
timeout=60
workers=1
threads=1

[replication]
import_acoustid=http://data.acoustid.org/replication/acoustid-update-{seq}.xml.bz2

[rate_limiter]
#application.123=4

[mail]
#host=smtp.example.com
#port=587
#security=starttls
#username=XXX
#password=XXX
#from_address=AcoustID <noreply@acoustid.org>
#timeout=10
# Site-wide caps on the emails the website sends; 0 or unset for none.
#max_per_hour=200
#max_per_day=2000

[export]
#directory=/var/lib/acoustid/data-export
#max_days=30
